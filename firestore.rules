rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    function isStaff() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.role in ['user', 'admin', 'moderator', 'staff'] &&
             data.createdAt is number;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'images', 'stock', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.images is list && data.images.size() > 0 &&
             data.stock is number &&
             data.createdAt is number;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'total', 'status', 'shippingDetails', 'paymentMethod', 'createdAt']) &&
             (((request.auth != null) && data.userId == request.auth.uid) || (request.auth == null && data.userId == 'guest')) &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.shippingDetails is map &&
             data.createdAt is number;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['productId', 'createdAt']) &&
             data.productId is string && data.productId.size() > 0 &&
             data.createdAt is number;
    }

    function isValidProductReview(data) {
      return data.keys().hasAll(['productId', 'name', 'rating', 'text', 'createdAt', 'isActive']) &&
             data.productId is string && data.productId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.text is string && data.text.size() <= 1000 &&
             data.createdAt is number &&
             data.isActive is bool;
    }

    // --- Rules ---

    match /users/{userId} {
      allow read: if isSignedIn(); // Allow users to see each other (basic profile) or restricted to owner if needed
      allow create: if (isSignedIn() && isValidUser(request.resource.data)) || (isAdmin() && request.resource.data.keys().hasAll(['uid', 'role', 'createdAt']) && request.resource.data.role in ['user', 'admin', 'staff']);
      allow update: if (isOwner(userId) || isAdmin()) && 
                    (request.resource.data.role == resource.data.role || isAdmin()); // Prevent users from self-promoting
                    
      match /favorites/{productId} {
        allow read: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(productId) && isValidFavorite(request.resource.data);
        allow update: if isOwner(userId) && isValidFavorite(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isStaff()) && isValidProduct(request.resource.data);
      allow delete: if isAdmin() || isStaff();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidOrder(request.resource.data);
      allow update: if isAdmin() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) || 
        isValidOrder(request.resource.data)
      );
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidProductReview(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read, write: if isAdmin();
    }
  }
}
